#!/usr/bin/env python3
"""
bryce-input: fixes Bryce 3D's 1997 mouse handling in the VM's absolute-pointer
display. Runs as root once Xorg is up. It takes exclusive hold (EVIOCGRAB) of
the VM's pointing device ("Virtual USB Digitizer"), so Xorg no longer reads it,
and replays the events into X through XTest with two corrections:

1. Drags that "accelerate" (trackballs, sliders, camera controls).
   Bryce hides the cursor during such drags and keeps moving it back to the
   middle with SetCursorPos, reading how far it moved each time. The host
   sends absolute positions that never learn about those jumps, so each event
   looks like a jump from the middle to the host's pointer. Once the app has
   moved the pointer during a drag, switch to relative motion: send the X
   pointer's current position plus the host's motion.

2. Pop-up menus that close at once (preset libraries, Mac-style menus).
   Bryce opens them on button-down and closes them on button-up unless the
   pointer is over an item; on a modern CPU the menu is already open when a
   normal click releases the button. If a click's release comes while a new
   pop-up (override-redirect) window has appeared since the press, hold the
   button "down" while the user moves, so the menu tracks the pointer as on a
   classic Mac; the user's next click releases it over the chosen item.
"""
import sys
import time

import evdev
from evdev import ecodes as E
from Xlib import X, display as xdisplay
from Xlib.ext import xtest

CLICK_MAX_S = 0.6
CLICK_MAX_PX = 4
BUTTONS = {E.BTN_LEFT: 1, E.BTN_MIDDLE: 2, E.BTN_RIGHT: 4}   # bit in our mask
XBUTTON = {1: 1, 2: 2, 4: 3}                                  # mask bit -> X button


def log(*a):
    print("[bryce-input]", *a, flush=True)


class Injector:
    """Sends pointer state to X through XTest and reads X's pointer and pop-ups."""

    def __init__(self):
        self.d = xdisplay.Display(":0")
        self.root = self.d.screen().root
        g = self.root.get_geometry()
        self.w, self.h = g.width, g.height
        self.mask = 0

    def pointer(self):
        p = self.root.query_pointer()
        return p.root_x, p.root_y

    def popups(self):
        """Visible pop-up menus: (id, x, y, w, h) of override-redirect windows
        that are drawn on screen. Leaves out Wine's helpers: 1x1 off-screen
        windows, invisible InputOnly windows and anything covering the whole
        screen. Wine may keep a closed menu mapped but hidden or off-screen and
        reuse it, so a menu counts as "new" when its id or geometry changed."""
        found = set()
        for win in self.root.query_tree().children:
            try:
                a = win.get_attributes()
                if not a.override_redirect or a.map_state != X.IsViewable or a.win_class != X.InputOutput:
                    continue
                g = win.get_geometry()
            except Exception:
                continue
            if g.width <= 2 or g.height <= 2:
                continue
            if g.x >= self.w or g.y >= self.h or g.x + g.width <= 0 or g.y + g.height <= 0:
                continue
            if g.width >= self.w and g.height >= self.h:
                continue
            found.add((win.id, g.x, g.y, g.width, g.height))
        return found

    def refresh(self):
        g = self.root.get_geometry()
        self.w, self.h = g.width, g.height

    def send(self, mask, x, y):
        x = max(0, min(self.w - 1, x))
        y = max(0, min(self.h - 1, y))
        xtest.fake_input(self.d, X.MotionNotify, x=x, y=y)
        for bit, button in XBUTTON.items():
            if (mask & bit) != (self.mask & bit):
                xtest.fake_input(self.d, X.ButtonPress if mask & bit else X.ButtonRelease, button)
        self.d.sync()
        self.mask = mask
        return x, y

    def wheel(self, button):
        xtest.fake_input(self.d, X.ButtonPress, button)
        xtest.fake_input(self.d, X.ButtonRelease, button)
        self.d.sync()


def tell_host(msg):
    """Message to the Mac app over the control port (/dev/hvc1)."""
    try:
        with open("/dev/hvc1", "w") as f:
            f.write(msg + "\n")
    except OSError:
        pass


class PointerFixer:
    def __init__(self, inj):
        self.inj = inj
        self.client = None
        self.sent = None
        self._relative = False
        self.press = None
        self.menu = None

    # While a relative drag runs, the Mac app hides its cursor and moves it
    # back to the middle of the window whenever it nears an edge, so drags
    # never stop at the window or screen edge.
    @property
    def relative(self):
        return self._relative

    @relative.setter
    def relative(self, on):
        if on != self._relative:
            self._relative = on
            tell_host("rel 1" if on else "rel 0")

    def out(self, mask, x, y):
        self.sent = self.inj.send(mask, x, y)

    def event(self, mask, x, y):
        inj = self.inj
        prev_client, self.client = self.client, (x, y)
        b1_down, b1_was = mask & 1, inj.mask & 1

        if self.menu is not None:                       # menu held open
            if not (self.menu & {p[0] for p in inj.popups()}):
                log("menu closed")
                self.menu = None
                return self.out(mask & ~1, x, y)
            if b1_down:
                self.press = ("menu",)
                return self.out(mask | 1, x, y)
            if self.press == ("menu",):
                self.menu, self.press = None, None
                return self.out(mask, x, y)
            return self.out(mask | 1, x, y)

        if b1_down and not b1_was:                      # press
            self.press = (time.monotonic(), x, y, inj.popups())
            self.relative = False
            return self.out(mask, x, y)

        if not b1_down and b1_was:                      # release
            p, self.press = self.press, None
            if p and p[0] != "menu" and time.monotonic() - p[0] < CLICK_MAX_S \
                    and abs(x - p[1]) <= CLICK_MAX_PX and abs(y - p[2]) <= CLICK_MAX_PX:
                new = inj.popups() - p[3]
                log(f"click at {x},{y}: new pop-ups {sorted(new)}")
                if new:
                    self.menu = {n[0] for n in new}
                    return self.out(mask | 1, x, y)
            if self.relative:
                self.relative = False
                return self.out(mask, *inj.pointer())
            return self.out(mask, x, y)

        if mask and prev_client is not None and self.sent is not None:   # drag
            sx, sy = inj.pointer()
            if not self.relative and (sx, sy) != self.sent:
                self.relative = True
            if self.relative:
                dx, dy = x - prev_client[0], y - prev_client[1]
                # A jump this large is the Mac app re-centring its cursor
                # (see above), not real motion: skip it.
                if abs(dx) > inj.w // 4 or abs(dy) > inj.h // 4:
                    return
                return self.out(mask, sx + dx, sy + dy)
        return self.out(mask, x, y)


def find_pointer():
    """The Mac's pointer: Apple's virtual USB digitizer. Never a device added
    by other software (e.g. the clipboard agent's "spice vdagent tablet")."""
    for _ in range(100):
        fallback = None
        for path in evdev.list_devices():
            dev = evdev.InputDevice(path)
            caps = dev.capabilities()
            if not (E.EV_ABS in caps and E.EV_KEY in caps and E.BTN_LEFT in caps[E.EV_KEY]):
                continue
            if "spice" in dev.name.lower():
                continue
            if "digitizer" in dev.name.lower():
                return dev
            fallback = fallback or dev
        if fallback:
            return fallback
        time.sleep(0.1)
    return None


def main():
    dev = find_pointer()
    if dev is None:
        log("no absolute pointing device found")
        return 1
    absinfo = {code: info for code, info in dev.capabilities()[E.EV_ABS]}
    ax, ay = absinfo[E.ABS_X], absinfo[E.ABS_Y]
    inj = Injector()
    fixer = PointerFixer(inj)
    dev.grab()
    log(f"using {dev.name} ({dev.path}), screen {inj.w}x{inj.h}")

    def scale(v, info, size):
        return round((v - info.min) * (size - 1) / max(1, info.max - info.min))

    x = y = 0
    mask = 0
    last_refresh = 0.0
    for ev in dev.read_loop():
        now = time.monotonic()
        if now - last_refresh > 1.0:            # screen size may change (scaling)
            inj.refresh()
            last_refresh = now
        if ev.type == E.EV_ABS:
            if ev.code == E.ABS_X:
                x = scale(ev.value, ax, inj.w)
            elif ev.code == E.ABS_Y:
                y = scale(ev.value, ay, inj.h)
        elif ev.type == E.EV_KEY and ev.code in BUTTONS:
            bit = BUTTONS[ev.code]
            mask = (mask | bit) if ev.value else (mask & ~bit)
        elif ev.type == E.EV_REL and ev.code == E.REL_WHEEL and ev.value:
            inj.wheel(4 if ev.value > 0 else 5)
        elif ev.type == E.EV_REL and ev.code == E.REL_HWHEEL and ev.value:
            inj.wheel(7 if ev.value > 0 else 6)
        elif ev.type == E.EV_SYN and ev.code == E.SYN_REPORT:
            fixer.event(mask, x, y)


if __name__ == "__main__":
    sys.exit(main())

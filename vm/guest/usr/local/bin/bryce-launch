#!/bin/bash
# Runs as user bryce inside the X session: Wine prefix on first start, then
# Bryce (2, 3D or 4, see /data/bryce.conf) under Hangover Wine with FEX
# translating its x86 code.
export WINEPREFIX=/data/wine WINEDEBUG=-all \
       WINEDLLOVERRIDES="mscoree=;mshtml=;winemenubuilder.exe=d" \
       HODLL=libwow64fex.dll FEX_X87REDUCEDPRECISION=1
log() { echo "[bryce-launch] $*"; }
. /data/bryce.conf || { log "no Bryce installed"; exit 1; }

if [ ! -f "$WINEPREFIX/.ready" ]; then
  log "creating the Wine prefix"
  # Leftovers of an interrupted attempt would look up to date to wineboot.
  rm -rf "$WINEPREFIX"
  wineboot --init >/dev/null 2>&1
  wineserver -w
  wine regedit /etc/bryce/bryce.reg >/dev/null 2>&1
  wineserver -w
  sync
  touch "$WINEPREFIX/.ready"
  sync
fi
# Settings added after a prefix was created (applied once per settings version).
if [ "$(cat "$WINEPREFIX/.settings" 2>/dev/null)" != 3 ]; then
  x11='HKCU\Software\Wine\X11 Driver'
  # Don't enforce ClipCursor through X: Wine's full-screen clip window can
  # outlive a menu and swallow every click. Bryce's drags are handled by bryce-input.
  wine reg add "$x11" /v GrabPointer /d N /f >/dev/null 2>&1
  # Wine places Bryce's windows itself, exactly where Bryce asks (as on
  # Windows), instead of the window manager moving and resizing them.
  # bryce-stack keeps palettes above the main window.
  wine reg add "$x11" /v Managed /d N /f >/dev/null 2>&1
  # The display is fixed at 640x480 (enlarged by the Mac app): no mode changes.
  wine reg add "$x11" /v UseXRandR /d N /f >/dev/null 2>&1
  wineserver -w
  echo 3 > "$WINEPREFIX/.settings"
fi
# QuickTime 3 (Bryce 4), unpacked from the CD by bryce-firstboot: Bryce finds
# it in the Windows system folder (the 32-bit one, syswow64).
if [ -d /data/quicktime ]; then
  cp -u /data/quicktime/* "$WINEPREFIX/drive_c/windows/syswow64/"
fi
# Bryce is started through bryce-run.exe, which loads brycefix.dll into it
# (screen copies for drop shadows, see vm/shim/).
cp -u /usr/lib/bryce/bryce-run.exe /usr/lib/bryce/brycefix.dll "$WINEPREFIX/drive_c/windows/syswow64/"
win=$(basename "$DIR" | sed 's/^bryce/Bryce/; s/3d$/3D/')      # bryce3d -> Bryce3D
ln -sfn "$DIR" "$WINEPREFIX/drive_c/$win"
ln -sfn /data/cd "$WINEPREFIX/dosdevices/d:"
ln -sfn "$HOME/projects" "$WINEPREFIX/dosdevices/e:"
ln -sfn "$HOME/projects" "$DIR/Projects"
# Content CDs: F:, G:, ... in alphabetical order, as CD-ROM drives so Bryce
# sees each disc's name. Wine's drive list is only rewritten when they change.
letters=(f g h i j k l m n o p q r s t u v w x y)
mapfile -t cds < <(ls /data/extra 2>/dev/null | head -n ${#letters[@]})
for x in "${letters[@]}"; do rm -f "$WINEPREFIX/dosdevices/$x:"; done
reg=$'REGEDIT4\n\n[HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives]\n'
for i in "${!letters[@]}"; do
  if [ -n "${cds[$i]:-}" ]; then
    ln -sfn "/data/extra/${cds[$i]}" "$WINEPREFIX/dosdevices/${letters[$i]}:"
    reg+="\"${letters[$i]}:\"=\"cdrom\""$'\n'
  else
    reg+="\"${letters[$i]}:\"=-"$'\n'
  fi
done
if ! printf '%s' "$reg" | cmp -s - "$WINEPREFIX/.drives.reg"; then
  printf '%s' "$reg" > "$WINEPREFIX/.drives.reg"
  wine regedit "$WINEPREFIX/.drives.reg" >/dev/null 2>&1
  wineserver -w
fi

cd "$DIR"
log "starting $NAME (FEX)"
# bryce-xfix.so: when Wine raises Bryce's main window, it stays below its
# palettes (no flicker; see vm/shim/bryce-xfix.c).
LD_PRELOAD=/usr/lib/bryce/bryce-xfix.so \
  wine 'C:\windows\syswow64\bryce-run.exe' "C:\\$win\\$EXE" "$@" >/tmp/bryce.log 2>&1
# Bryce has quit: end Wine's helper processes too (they never exit by
# themselves), so the session ends and the VM powers off.
wineserver -k
